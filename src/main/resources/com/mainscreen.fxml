<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: #F3E8D2;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mainscreenF">
    <children>
        <Pane layoutX="322.0" layoutY="-10.0" prefHeight="1120.0" prefWidth="1595.0" style="-fx-background-color: #F3E8D2;">
            <children>
                <ImageView fitHeight="1319.0" fitWidth="1980.0" layoutX="-341.0" layoutY="-6.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/fond_beige.png" />
                    </image>
                </ImageView>
                <ScrollPane fx:id="menuScroll" fitToWidth="true" layoutX="92.0" layoutY="92.0" prefHeight="899.0" prefWidth="989.0" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="NEVER">
                    <content>
                        <VBox fx:id="menuContainer" spacing="10" />
                    </content>
                </ScrollPane>
            </children>
        </Pane>
        <Pane layoutX="-3.0" layoutY="-4.0" prefHeight="1115.0" prefWidth="323.0">
            <children>
                <ImageView fitHeight="1287.0" fitWidth="1686.0" layoutX="-1362.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 8, 0);">
                    <image>
                        <Image url="@images/fond_rouge.png" />
                    </image>
                </ImageView>
                <ImageView fitHeight="271.0" fitWidth="274.0" layoutX="25.0" layoutY="27.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/Cacayalogo.png" />
                    </image>
                </ImageView>

                <VBox fx:id="menuBox" layoutX="40.0" layoutY="437.0" prefHeight="298.0" prefWidth="236.0" spacing="18.0" style="-fx-padding: -5;">

                    <Button fx:id="btnTous" onAction="#filterAll" prefHeight="82.0" prefWidth="289.0" style="-fx-background-color: transparent;" text="Tout" textAlignment="CENTER" textFill="#f3e8d2">
                        <font>
                            <Font size="33.0" />
                        </font>
                        <VBox.margin>
                            <Insets />
                        </VBox.margin>
                    </Button>

                    <Button fx:id="btnPlats" onAction="#filterPlats" prefHeight="76.0" prefWidth="325.0" style="-fx-background-color: transparent;" text="Plats" textAlignment="CENTER" textFill="#f3e8d2">
                        <font>
                            <Font size="33.0" />
                        </font>
                    </Button>

                    <Button fx:id="btnSnacks" onAction="#filterSnacks" prefHeight="70.0" prefWidth="260.0" style="-fx-background-color: transparent;" text="Snacks" textAlignment="CENTER" textFill="#f3e8d2">
                        <font>
                            <Font size="33.0" />
                        </font>
                    </Button>

                    <Button fx:id="btnBoissons" onAction="#filterBoissons" prefHeight="70.0" prefWidth="260.0" style="-fx-background-color: transparent;" text="Boissons" textAlignment="CENTER" textFill="#f3e8d2">
                        <font>
                            <Font size="30.0" />
                        </font>
                    </Button>

                    <Button fx:id="btnDesserts" onAction="#filterDesserts" prefHeight="70.0" prefWidth="260.0" style="-fx-background-color: transparent;" text="Desserts" textAlignment="CENTER" textFill="#f3e8d2">
                        <font>
                            <Font size="30.0" />
                        </font>
                    </Button>
                    <opaqueInsets>
                        <Insets />
                    </opaqueInsets>

                </VBox>
                <Button fx:id="btnRetour" layoutX="25.0" layoutY="920.0" onAction="#retourAccueil" prefHeight="70.0" prefWidth="260.0" style="-fx-background-color: transparent;" text="Retour" textAlignment="CENTER" textFill="#f3e8d2">
                    <font>
                        <Font name="Bauhaus 93" size="40.0" />
                    </font>
                </Button>
            </children>
        </Pane>
        <Pane layoutX="1465.0" layoutY="49.0" prefHeight="906.0" prefWidth="422.0">
            <children>
                <Pane layoutX="17.0" layoutY="212.0" prefHeight="542.0" prefWidth="385.0" style="-fx-background-color: #FFE1E6; -fx-padding: 50; -fx-background-radius: 50;">
                    <children>
                        <Line endX="162.0" layoutX="182.0" layoutY="440.0" startX="-140.5" strokeWidth="2.0" />
                        <Label fx:id="price" layoutX="92.0" layoutY="448.0" prefHeight="58.0" prefWidth="236.0" text="Prix : 0,00 €" textFill="#4a3c3c">
                            <font>
                                <Font name="Berlin Sans FB" size="37.0" />
                            </font>
                        </Label>
                        <ScrollPane layoutX="31.0" layoutY="36.0" prefHeight="372.0" prefWidth="317.0" style="-fx-background-color: transparent; -fx-background: transparent;">
                            <content>
                                <VBox fx:id="cartContainer" spacing="1" style="-fx-background-color: transparent;" />
                            </content>
                        </ScrollPane>
                    </children>
                </Pane>
                <Button fx:id="btnPayer" layoutX="18.0" layoutY="795.0" mnemonicParsing="false" onAction="#goPanier" prefHeight="124.0" prefWidth="371.0" style="-fx-background-color: pink; -fx-background-radius: 50;" text="Panier" textFill="#614848">
                    <font>
                        <Font name="Berlin Sans FB" size="50.0" />
                    </font>
                </Button>
            </children>
        </Pane>
    </children>
</AnchorPane>
